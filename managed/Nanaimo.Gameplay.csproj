<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Nanaimo.Gameplay</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Nanaimo.Adapter" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.16" />
    <Content Include="../adapter_runtime/资源/数据/**/*" Link="资源/数据/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\release\components\cards\synthesis_recipe_data.inc" LogicalName="OpenNanaimo.Adapter.CardSynthesisRecipes.inc" />
    <EmbeddedResource Include="..\release\components\target_resources\arena_target_catalog.json" LogicalName="OpenNanaimo.Adapter.ArenaTargets.json" />
    <EmbeddedResource Include="..\release\components\stage_damage\boss_contact_registry.json" LogicalName="OpenNanaimo.Adapter.BossContacts.json" />
  </ItemGroup>
</Project>
